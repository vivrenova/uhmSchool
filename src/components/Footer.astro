---
// Футер на всіх сторінках демо: про школу, швидкий перехід між сторінками, контакти розробника.
import Logo from './Logo.astro';
import { SCHOOL } from '../config/school';
import { AUTHOR } from '../config/author';
import { DEMO_PAGES, normalizePath } from '../config/demoPages';

const current = normalizePath(Astro.url.pathname);

const authorLinks: { href: string; label: string }[] = [];
if (AUTHOR.telegram) authorLinks.push({ href: `https://t.me/${AUTHOR.telegram}`, label: 'Telegram' });
if (AUTHOR.email) authorLinks.push({ href: `mailto:${AUTHOR.email}`, label: 'Пошта' });
if (AUTHOR.github) authorLinks.push({ href: AUTHOR.github, label: 'GitHub' });
---

<footer class="footer on-ink">
  <div class="wrap footer__grid">
    <div class="footer__school">
      <Logo />
      <p>{SCHOOL.tagline}. Онлайн, групи до 8 людей.</p>
    </div>

    <div class="footer__demo">
      <p class="footer__demo-title">Це демо</p>
      <p>
        Школа, люди, відгуки й оплати на сайті вигадані. Фото — з Unsplash. Сайт показує, як виглядатиме й працюватиме сторінка
        курсу вашої школи: оплата, доступ, лист очікування, кабінет власника.
      </p>

      <nav aria-label="Сторінки демо">
        <ul class="pills">
          {
            DEMO_PAGES.map((p) => (
              <li>
                <a href={p.href} aria-current={current === p.href ? 'page' : undefined}>
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        authorLinks.length > 0 && (
          <p class="footer__author">
            <span>{AUTHOR.label}</span>
            {authorLinks.map((l) => (
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {l.label}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #cfc8bb;
    padding-block: 56px;
  }
  /* На сторінці курсу внизу є липка панель з кнопкою — не ховаємо під нею футер. */
  :global(body:has(.sticky-cta)) .footer {
    padding-bottom: calc(56px + 76px);
  }
  .footer :global(.logo) {
    color: var(--paper);
  }
  .footer__grid {
    display: grid;
    gap: 40px;
  }
  .footer__school {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .footer__demo {
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid #4a463f;
    border-radius: 16px;
    align-content: start;
  }
  .footer__demo-title {
    color: var(--paper);
    font-weight: 600;
  }

  .pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .pills a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid #6b655b;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 500;
    color: var(--paper);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .pills a:hover {
    background: #2b2925;
    border-color: #8a8378;
  }
  .pills a[aria-current='page'] {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  .footer__author {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
    padding-top: 14px;
    border-top: 1px solid #4a463f;
  }
  .footer__author span {
    flex-basis: 100%;
    color: #b9b2a6;
  }
  @media (min-width: 600px) {
    .footer__author span {
      flex-basis: auto;
    }
  }
  .footer__author a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--paper);
  }

  @media (min-width: 960px) {
    .footer {
      padding-block: 72px;
    }
    :global(body:has(.sticky-cta)) .footer {
      padding-bottom: 72px;
    }
    .footer__grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 64px;
    }
    .footer__demo {
      padding: 24px;
    }
  }
</style>
