---
import Pen from './Pen';
import { SCHOOL } from '../config/school';

interface Props {
  href?: string;
  withTagline?: boolean;
}
const { href = '/', withTagline = false } = Astro.props;
---

<a href={href} class="logo" aria-label={`${SCHOOL.name} — ${SCHOOL.tagline}, на головну`}>
  <span class="logo__mark" aria-hidden="true"><Pen kind="strike">uhm</Pen><span class="logo__dot">.</span></span>
  {withTagline && <span class="logo__tagline" aria-hidden="true">{SCHOOL.tagline}</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    text-decoration: none;
    color: var(--ink);
  }
  .logo__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.04em;
    padding-bottom: 3px;
  }
  .logo__mark :global(.pen__svg) {
    transform: translateY(-38%) rotate(-3deg);
  }
  .logo__dot {
    color: var(--red);
  }
  .logo__tagline {
    font-size: 16px;
    line-height: 1.2;
    color: var(--ink-3);
    max-width: 9.5em;
  }
</style>
