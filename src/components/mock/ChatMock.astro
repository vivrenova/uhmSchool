---
// «Скрін» чату групи в Telegram між заняттями.
import { TEACHER } from '../../config/school';

type Msg =
  | { who: string; color: string; text?: string; voice?: string; files?: { icon: 'video' | 'pdf'; name: string; meta: string }[]; reply?: { who: string; text: string }; time: string; out?: false }
  | { out: true; voice?: string; text?: string; time: string };

const T = TEACHER.firstName;
const msgs: Msg[] = [
  {
    who: T,
    color: '#b0402a',
    files: [
      { icon: 'video', name: 'Запис заняття 5', meta: '1:29:40' },
      { icon: 'pdf', name: 'lesson-05.pdf', meta: '2,4 МБ' },
    ],
    text: 'Запис і слайди тут. Хто пропустив — подивіться до четверга 🙌',
    time: '21:04',
  },
  {
    who: T,
    color: '#b0402a',
    text: 'Голосове на завтра: місце, куди ви давно хочете поїхати, і чому. Спробуйте «I’ve always wanted to…» та «I’d love to…»',
    time: '21:06',
  },
  { who: 'Марта', color: '#1f6aa5', voice: '0:58', time: '21:31' },
  {
    who: 'Андрій',
    color: '#2b7a36',
    text: 'Ярино, а можна в четвер підключитись до групи Пн/Ср? У мене відрядження',
    time: '21:40',
  },
  {
    who: T,
    color: '#b0402a',
    reply: { who: 'Андрій', text: 'а можна в четвер підключитись до групи Пн/Ср?' },
    text: 'Так, у середу о 19:30 є місце. Посилання те саме 👍',
    time: '21:44',
  },
  { out: true, voice: '1:12', time: '22:15' },
];

const wave = (seed: number) =>
  Array.from({ length: 26 }, (_, i) => 3 + Math.round(Math.abs(Math.sin((i + seed) * 1.3) * 8 + Math.cos(i * 0.7) * 4)));
---

<figure class="chat" role="img" aria-label={`Скрін чату групи в Telegram: ${T} надсилає запис заняття, слайди й тему голосового на завтра, учні відповідають голосовими, Андрій домовляється про перенесення заняття.`}>
  <div class="chat__phone" aria-hidden="true">
    <div class="chat__head">
      <svg class="chat__back" viewBox="0 0 12 20"><path d="M10 2L2 10l8 8" /></svg>
      <span class="chat__ava">u.</span>
      <span class="chat__title">
        <b>Speaking B1 · Вт/Чт</b>
        <span>8 учасників</span>
      </span>
    </div>

    <div class="chat__body">
      <span class="chat__date">Сьогодні</span>
      {
        msgs.map((m, idx) =>
          m.out ? (
            <div class="msg msg--out">
              {m.voice && (
                <span class="voice">
                  <span class="voice__play" />
                  <span class="voice__wave">
                    {wave(idx).map((h) => (
                      <i style={`height:${h}px`} />
                    ))}
                  </span>
                  <span class="voice__len">{m.voice}</span>
                </span>
              )}
              <span class="msg__time">
                {m.time} <span class="msg__ticks">✓✓</span>
              </span>
            </div>
          ) : (
            <div class="msg">
              <b class="msg__who" style={`color:${m.color}`}>
                {m.who}
              </b>
              {m.reply && (
                <span class="msg__reply">
                  <b>{m.reply.who}</b>
                  <span>{m.reply.text}</span>
                </span>
              )}
              {m.files?.map((f) => (
                <span class="file">
                  <span class:list={['file__icon', `file__icon--${f.icon}`]}>{f.icon === 'pdf' ? 'PDF' : '▶'}</span>
                  <span class="file__txt">
                    <b>{f.name}</b>
                    <span>{f.meta}</span>
                  </span>
                </span>
              ))}
              {m.voice && (
                <span class="voice">
                  <span class="voice__play" />
                  <span class="voice__wave">
                    {wave(idx).map((h) => (
                      <i style={`height:${h}px`} />
                    ))}
                  </span>
                  <span class="voice__len">{m.voice}</span>
                </span>
              )}
              {m.text && <span class="msg__text">{m.text}</span>}
              <span class="msg__time">{m.time}</span>
            </div>
          ),
        )
      }
    </div>

    <div class="chat__input">
      <span>Повідомлення</span>
      <svg viewBox="0 0 20 20"><path d="M10 3a2.5 2.5 0 0 1 2.5 2.5v4a2.5 2.5 0 0 1-5 0v-4A2.5 2.5 0 0 1 10 3zM5 9.5a5 5 0 0 0 10 0M10 14.5V17" /></svg>
    </div>
  </div>
  <slot />
</figure>

<style>
  .chat {
    margin: 0;
  }
  .chat__phone {
    max-width: 380px;
    border-radius: 22px;
    overflow: hidden;
    background: #dfe6d3;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.32;
    color: #111;
    box-shadow:
      0 0 0 6px #181715,
      0 20px 40px -20px rgba(24, 23, 21, 0.5);
    margin: 6px;
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #fbfbf8;
    border-bottom: 1px solid #e3e3dc;
  }
  .chat__back {
    width: 10px;
    height: 18px;
    fill: none;
    stroke: #3b82c4;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chat__ava {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #181715;
    color: #f4f0e8;
    font-weight: 800;
    font-size: 15px;
  }
  .chat__title {
    display: grid;
  }
  .chat__title b {
    font-size: 15px;
  }
  .chat__title span {
    font-size: 12px;
    color: #66665f;
  }

  .chat__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 10px 12px;
  }
  .chat__date {
    align-self: center;
    padding: 2px 10px;
    border-radius: 10px;
    background: #56634b;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
  }

  .msg {
    position: relative;
    align-self: flex-start;
    display: grid;
    gap: 5px;
    max-width: 86%;
    padding: 6px 10px 18px;
    border-radius: 14px 14px 14px 4px;
    background: #fff;
  }
  .msg--out {
    align-self: flex-end;
    border-radius: 14px 14px 4px 14px;
    background: #e3f6cf;
  }
  .msg__who {
    font-size: 13px;
  }
  .msg__time {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-size: 11px;
    color: #66665f;
  }
  .msg--out .msg__time {
    color: #3a7a36;
  }
  .msg__ticks {
    letter-spacing: -3px;
  }
  .msg__text {
    padding-right: 26px;
  }
  .msg__reply {
    display: grid;
    padding: 2px 8px;
    border-left: 3px solid #2b7a36;
    border-radius: 3px;
    background: #f1f7f1;
    font-size: 13px;
  }
  .msg__reply b {
    color: #2b7a36;
  }
  .msg__reply span {
    color: #444;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .file__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #2b6cb0;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .file__icon--video {
    background: #2a2a2d;
    font-size: 14px;
  }
  .file__txt {
    display: grid;
  }
  .file__txt span {
    font-size: 12px;
    color: #66665f;
  }

  .voice {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 30px;
  }
  .voice__play {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #3b82c4;
    flex: none;
  }
  .msg--out .voice__play {
    background: #5fae4f;
  }
  .voice__play::after {
    content: '';
    position: absolute;
    left: 14px;
    top: 11px;
    border-left: 10px solid #fff;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
  }
  .voice__wave {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 24px;
  }
  .voice__wave i {
    display: block;
    width: 2.5px;
    border-radius: 2px;
    background: #7aa7cf;
  }
  .msg--out .voice__wave i {
    background: #7fbf6e;
  }
  .voice__len {
    font-size: 12px;
    color: #66665f;
    font-variant-numeric: tabular-nums;
  }

  .chat__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: #fbfbf8;
    border-top: 1px solid #e3e3dc;
    color: #66665f;
  }
  .chat__input svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #66665f;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
</style>
