---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Learn from '../components/islands/Learn';
import { SCHOOL } from '../config/school';

const ssrNow = Date.now();
---

<Base title={`Кабінет учня — ${SCHOOL.name}`} noindex>
  <PageHeader backLabel="На сайт школи" />
  <main class="wrap" style="padding-block: 24px 72px">
    <Learn client:only="preact" ssrNow={ssrNow} />
  </main>
</Base>
